# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Dataset -- large, and shouldn't be committed; data.py's error message
# tells anyone cloning this repo exactly how to get it themselves.
data/raw/

# MLflow tracking store -- generated locally, not source code.
# Each contributor/environment builds their own by running the training
# scripts; committing this would also leak host-specific absolute paths
# (the exact problem we hit when Dockerizing in Phase 4).
mlflow.db
mlartifacts/
mlruns/

# Drift reference data + retrain state -- also generated, not source.
data/reference/
data/retrain_state.json

# NOTE: exported_model/ is intentionally NOT ignored -- unlike mlflow.db/
# mlartifacts/ (which embed host-specific absolute paths), this is a
# small, clean, portable model artifact. CI needs it to build the Docker
# image without requiring the full dataset or a live MLflow registry in
# the pipeline. Re-export and commit it whenever you promote a new
# production version (see training/promotion.py).

# Local model artifact from Phase 1 (plain joblib, pre-MLflow)
data/model.joblib

# IDE
.vscode/

# OS
.DS_Store
Thumbs.db